# Copia este fichero a .env y rellénalo. Los valores vacíos son obligatorios u opcionales según el README.

# Contraseña Airsonic
AIRSONIC_PASSWORD=
# URL base de Airsonic
AIRSONIC_URL=http://localhost:4040
# Usuario Airsonic
AIRSONIC_USER=admin
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
# API key de Last.fm
LASTFM_API_KEY=
SETTINGS_PASSWORD=
# Colección 1 = raíz de 'moode' (la colección completa que sirve Airsonic; dentro tiene temp/ para discos sin decidir). Ruta host (bind mount — requiere recrear el contenedor)
TRASVASE_COLLECTION_1_PATH=
# Colección 2 = ruta de 'lidarr' (descargas), carpeta/disco totalmente distinto de la Colección 1. Ruta host (bind mount — requiere recrear el contenedor)
TRASVASE_COLLECTION_2_PATH=

# ── docker-compose.yml ──────────────────────────────────────────
# Carpeta de discos sin decidir
TRASVASE_TEMP_PATH=./datos/temp
# Uid:gid del usuario dueño de esta carpeta (los ficheros que se generan son suyos)
UID_GID=1000:1000
# Zona horaria de los trabajos programados (Ofelia)
TZ=Europe/Madrid
